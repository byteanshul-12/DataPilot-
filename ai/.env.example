# AI Model Credentials (Provide at least one for live LLM responses)
GEMINI_API_KEY=your_gemeni_api_key        # Recommended: Google Gemini API Key
OPENAI_API_KEY=your_openai_api_key_here          # Optional: OpenAI API Key (e.g. gpt-4o-mini)

# Web Scraping API Config
MAXUN_API_URL=              # Maxun API server URL
MAXUN_API_KEY=            # Maxun API Key (if authentication enabled)

# Optional Fallback Search APIs
TAVILY_API_KEY=your_tavily_api_key_here          # Optional search API
FIRECRAWL_API_KEY=your_firecrawl_api_key_here    # Optional Firecrawl scraping key

# Server Settings
PORT=8001
MODEL_NAME=gemini-2.5-flash
LOG_LEVEL=INFO
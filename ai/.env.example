# Model Configuration (Single Fine-Tuned / Open-Source Model)
# Provider options: http | huggingface
MODEL_PROVIDER=http
MODEL_NAME=datapilot-fine-tuned-v1
MODEL_ENDPOINT=http://localhost:8001
MODEL_API_KEY=

# Tool API Keys
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Runtime Settings
MAX_ITERATIONS=5
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO

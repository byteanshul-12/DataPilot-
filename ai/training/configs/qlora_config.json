{
  "base_model_name": "Qwen/Qwen2.5-7B-Instruct",
  "output_dir": "./checkpoints/datapilot-qwen2.5-7b-lora",
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "bias": "none",
  "task_type": "CAUSAL_LM",
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "learning_rate": 0.0002,
  "num_train_epochs": 3,
  "max_seq_length": 1024,
  "warmup_ratio": 0.03,
  "weight_decay": 0.0,
  "logging_steps": 10,
  "eval_strategy": "epoch",
  "save_strategy": "epoch",
  "save_total_limit": 2,
  "seed": 42,
  "fp16": true,
  "bf16": false,
  "report_to": "none",
  "quantization": "4bit"
}

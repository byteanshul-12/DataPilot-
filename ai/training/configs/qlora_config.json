{
  "base_model_name": "meta-llama/Meta-Llama-3-8B-Instruct",
  "output_dir": "./checkpoints/datapilot-lora",
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "bias": "none",
  "task_type": "CAUSAL_LM",
  "per_device_train_batch_size": 4,
  "gradient_accumulation_steps": 4,
  "learning_rate": 0.0002,
  "num_train_epochs": 3,
  "logging_steps": 10,
  "save_strategy": "epoch",
  "quantization": "4bit"
}
